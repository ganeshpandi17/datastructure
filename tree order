class Node:
    def __init__(self,data):
        self.data=data
        self.left=None
        self.right=None
def inorder(root):
    if root:
        inorder(root.left)
        print(root.data,end=" ")           
        inorder(root.right)
def preorder(root):
    if root:
        print(root.data,end=" ")
        preorder(root.left)
        preorder(root.right)
def postorder(root):
    if root:
        postorder(root.left)
        postorder(root.right)
        print(root.data,end=" ")
root=Node("one")
root.left=Node("two")
root.right=Node("three")
print("Inorder\n")
inorder(root)
print("Preorder\n")
preorder(root)
print("Postorder\n")
postorder(root)
