size = int(input("Enter hash table size: "))
hash_table = [None] * size

def insert(roll):
    key = roll % size

    while hash_table[key] is not None:
        key = (key + 1) % size

    hash_table[key] = roll
    print("Student inserted")

def search(roll):
    key = roll % size

    for i in range(size):
        if hash_table[key] == roll:
            print("Student found")
            return
        if hash_table[key] is None:
            break
        key = (key + 1) % size

    print("Student not found")

def delete(roll):
    for i in range(size):
        key = (roll % size + i) % size

        if hash_table[key] == roll:
            hash_table[key] = None
            print("Student deleted")
            return

        if hash_table[key] is None:
            break

    print("Student not found")

def display():
    print(hash_table)

while True:
    print("\n1. Insert")
    print("2. Search")
    print("3. Delete")
    print("4. Display")
    print("5. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:
        roll = int(input("Enter roll number: "))
        insert(roll)
    elif ch == 2:
        roll = int(input("Enter roll number: "))
        search(roll)
    elif ch == 3:
        roll = int(input("Enter roll number: "))
        delete(roll)
    elif ch == 4:
        display()
    elif ch == 5:
        break
    else:
        print("Invalid choice")
