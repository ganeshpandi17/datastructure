# Binary Search

n = int(input("Enter number of students: "))
a = []

for i in range(n):
    r = int(input("Enter roll number: "))
    a.append(r)

a.sort()

print("Sorted roll numbers:", a)

x = int(input("Enter roll number to search: "))

low = 0
high = n - 1
found = False

while low <= high:
    mid = (low + high) // 2

    if a[mid] == x:
        found = True
        break
    elif a[mid] < x:
        low = mid + 1
    else:
        high = mid - 1

if found:
    print("Roll number found")
else:
    print("Roll number not found")
