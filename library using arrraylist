class Book:
    def __init__(self, data):
        self.data = data
        self.next = None
class Library:
    def __init__(self):
        self.top = None
    def push(self, title):
        newNode = Book(title)
        if self.top is None:
            newNode.next = None
        else:
            newNode.next = self.top
     self.top = newNode
        print("Book added successfully.")
    def pop(self):
        if self.top is None:
            print("Stack is Empty!!!")
        else:
            temp = self.top
            self.top = self.top.next
            print("Removed Book:", temp.data)
    def display(self):
        if self.top is None:
            print("Stack is Empty!!!")
        else:
            temp = self.top
            print("Books in Stack:")
            while temp is not None:
                print(temp.data)
                temp = temp.next
stack = Library()

while True:
    print("\n--- STACK USING LINKED LIST ---")
    print("1. Push (Add Book)")
    print("2. Pop (Remove Book)")
    print("3. Display Books")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == '1':
        title = input("Enter Book Title: ")
        stack.push(title)

    elif choice == '2':
        stack.pop()

    elif choice == '3':
        stack.display()

    elif choice == '4':
        print("Program Ended.")
        break

    else:
        print("Invalid Choice!")
